<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- For Biometric authentication -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- For the optional Sync-completion notification (API 33+). The notification
         itself is gated by the user's "Completion notification" preference; we
         request the runtime permission only when they toggle it ON. If denied,
         sync still runs silently. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- For QR Scanning in TOTP -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- For Creating encrypted backups and import on manual user intervention only-->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />

    <!-- The INTERNET / ACCESS_NETWORK_STATE strip lives in src/full/AndroidManifest.xml:
         only the full flavor pulls ML Kit (whose Firelog transport injects those
         permissions). The fdroid flavor has no ML Kit, so its merged manifest never
         contains INTERNET in the first place. -->

    <!--
        Package visibility for the passkey provider, NOT a permission: lets 1Key
        see apps that open https links (browsers, and apps with verified App
        Links) so Settings can list installed browsers to trust and, later, read
        Android's own link-verification state for a native app. The wildcard
        host is what matches host-specific App Links filters. Deliberately not
        QUERY_ALL_PACKAGES, which Play reserves for other app categories.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" android:host="*" />
        </intent>
    </queries>

    <application
        android:name=".OneKeyApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="${appName}"
        android:supportsRtl="true"
        android:theme="@style/Theme.OneKey">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Autofill unlock activity. Launched by the system through a
            PendingIntent attached to a Dataset.setAuthentication chip when
            the vault is locked, or directly when the user taps the "Search
            1Key" trailing chip after we already produced match Datasets.

            exported=false: PendingIntent retains our app identity at delivery
            time, so the system does not need component-level export.
            excludeFromRecents=true: this is a transient unlock surface - it
            must not appear in the user's recent-apps thumbnail strip.
            taskAffinity="" plus launchMode=singleInstance: keeps the autofill
            UI out of MainActivity's task stack and guarantees only one
            instance regardless of how many fields the user retries on.
        -->
        <activity
            android:name=".feature.autofill.presentation.AutofillUnlockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleInstance"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.OneKey" />

        <!--
            Autofill save activity. Launched by OneKeyAutofillService.onSaveRequest
            (NOT by the system directly), running inside our own process, so
            exported=false is correct.

            Same task-isolation rationale as the unlock activity.
        -->
        <activity
            android:name=".feature.autofill.presentation.AutofillSaveActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleInstance"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.OneKey" />

        <!--
            AutofillService.

            BIND_AUTOFILL_SERVICE is a signature-or-system permission only the
            OS holds; requiring it on the <service> blocks any non-system
            caller from binding (which would otherwise let any app receive
            the user's structure-walking output).

            exported=true: required so the framework can resolve the
            component.
            directBootAware=false: the vault key is unavailable before user
            unlock anyway; binding pre-unlock would just be a no-op.
        -->
        <service
            android:name=".feature.autofill.service.OneKeyAutofillService"
            android:exported="true"
            android:directBootAware="false"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service_config" />
        </service>

        <!--
            Credential Manager passkey provider (Android 14+).

            BIND_CREDENTIAL_PROVIDER_SERVICE is held only by the system, so no
            other app can bind. android:enabled is false below API 34 through
            res/values/bools.xml (true in values-v34), which keeps the component
            out of Settings on older releases. exported=true is required for the
            framework to resolve the component. Nothing in this service or its
            activities touches the network; see docs/internal/PASSKEYS_PLAN.md.
        -->
        <service
            android:name=".feature.passkey.service.OneKeyCredentialProviderService"
            android:enabled="@bool/passkey_provider_enabled"
            android:exported="true"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE">
            <intent-filter>
                <action android:name="android.service.credentials.CredentialProviderService" />
            </intent-filter>
            <meta-data
                android:name="android.credentials.provider"
                android:resource="@xml/passkey_provider" />
        </service>

        <!--
            Passkey ceremony activities, launched only through the provider's
            PendingIntents. exported=false keeps them private; excludeFromRecents
            and an empty taskAffinity keep them out of the main task, as for the
            autofill activities. singleTop rather than singleInstance so a
            passkey request and an autofill request never cancel each other.
        -->
        <activity
            android:name=".feature.passkey.presentation.PasskeyGetActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.OneKey" />

        <activity
            android:name=".feature.passkey.presentation.PasskeyCreateActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.OneKey" />
    </application>
</manifest>
